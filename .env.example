# ==============================================================================
# BP Email Header Analyzer - Configurações do Ambiente (.env)
# ==============================================================================

# Nome do projeto e prefixo das rotas da API
PROJECT_NAME="bp-email-analiser"
API_PREFIX="/api"

# Limites de rede e requisições
NETWORK_TIMEOUT_SECONDS=2.5
MAX_HEADER_SIZE_BYTES=1000000

# ==============================================================================
# Configurações de Auditoria e Logging
# ==============================================================================

# Habilita ou desabilita a gravação de auditoria (True / False)
AUDIT_LOG_ENABLED=True

# Nível de detalhamento e verbosidade dos dados:
# - "FULL": Registra requisições HTTP + indicadores forenses + texto bruto completo do cabeçalho
# - "METADATA": Registra requisições HTTP + indicadores forenses (omite o texto bruto do cabeçalho)
# - "MINIMAL": Registra apenas o tráfego de acesso HTTP (IP, rota, código de status e latência)
AUDIT_LOG_LEVEL="FULL"

# Caminho do arquivo de auditoria (relativo ou absoluto)
AUDIT_LOG_FILE="logs/audit.log"

# Rotação de arquivos de log
AUDIT_LOG_MAX_BYTES=10485760  # 10 MB por arquivo
AUDIT_LOG_BACKUP_COUNT=5      # Mantém até 5 arquivos de backup rotacionados

# Duplicar logs no console / terminal (True / False)
AUDIT_LOG_STDOUT=True
